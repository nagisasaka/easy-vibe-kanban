# Example only: replace OWNER and VERSION with an actually published image.
LVK_IMAGE=ghcr.io/OWNER/lucky-vibe-kanban:VERSION
LVK_HOST=203.0.113.10
# Use automatic IP certificates with these Compose files. Keep port 80 open
# for Let's Encrypt validation and 443 open for HTTPS.
COMPOSE_FILE=compose.yaml:compose.acme.yaml
# Read https://letsencrypt.org/repository/ and change this to yes to agree.
LVK_ACME_AGREE_TOS=
# Optional contact address for your ACME account.
LVK_ACME_EMAIL=
# Optional. DNS *.preview.example.com must point to this server; the TLS
# certificate must cover both LVK_HOST and *.LVK_PREVIEW_DOMAIN. Requires
# externally managed certificates (COMPOSE_FILE=compose.yaml).
LVK_PREVIEW_DOMAIN=
